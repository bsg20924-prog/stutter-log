rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 소유자 계정(Google 로그인)만 읽기/쓰기 허용.
    // src/firebase.ts 의 OWNER_EMAIL 과 반드시 동일하게 유지할 것.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'bsg20924@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /logs/{docId} {
      allow read, write: if isOwner();
    }

    // 자가 진단 결과(기준선/이력)
    match /diagnostics/{docId} {
      allow read, write: if isOwner();
    }

    // 소리 지도 결과(압력 임계점 분석). 녹음 오디오는 저장하지 않고 평가값만 남긴다.
    match /soundMaps/{docId} {
      allow read, write: if isOwner();
    }

    // 상황 시뮬레이션 단독 실행 결과.
    // 소리 지도와 분리된 이유: 압력 사다리를 돌지 않고 시뮬레이션만 할 수 있고,
    // 그때는 카드/임계점 데이터가 없어 SoundMapResult 의 모양을 채울 수 없다.
    // 여기에도 오디오는 없다 — 녹음은 기기의 IndexedDB 에만 저장된다.
    match /simulations/{docId} {
      allow read, write: if isOwner();
    }

    // 앱 설정(기기 간 동기화). Gemini API 키가 여기 들어간다.
    //
    // ⚠️ 키를 프론트엔드 번들에 넣지 않는 이유가 바로 이 규칙이다:
    // 번들(/assets/*.js)은 로그인 없이 누구나 내려받을 수 있어서 거기 박힌 키는 곧 공개다.
    // 반면 이 컬렉션은 Google 서버가 isOwner() 를 강제하므로
    // 로그인한 소유자 외에는 읽을 수 없다.
    match /settings/{docId} {
      allow read, write: if isOwner();
    }

    // 그 외 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
